{{!-- MenuItems page: browse, add, update, delete, and recalculate cost.
      Browse table is populated by the "display all Menu Items" query in
      DML.sql; every submit button calls a stored procedure from PL.SQL
      through the matching route in app.js. --}}
<h1>Menu Items</h1>
<p>Manage the menu items Homegrown offers and their total ingredient cost.</p>

<section>
    <h2>READ &mdash; Browse Menu Items</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Menu Item Name</th>
                <th>Total Cost ($)</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            {{#each menuItems}}
            <tr>
                <td>{{this.menuItemID}}</td>
                <td>{{this.menuItemName}}</td>
                <td>{{this.menuItemTotalCost}}</td>
                <td>
                    {{!-- DELETE: per-row button so the user never types an ID;
                          calls sp_delete_menu_item (cascades to
                          MenuItemIngredients) --}}
                    <form method="POST" action="/menuItems/delete">
                        <input type="hidden" name="menuItemID" value="{{this.menuItemID}}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section>
    <h2>CREATE &mdash; Add a New Menu Item</h2>
    <form method="POST" action="/menuItems/add">
        <fieldset>
            <legend>New menu item details (<span class="required-marker">*</span> required)</legend>
            <p>
                <label for="add-menuItemName">Menu Item Name: <span class="required-marker">*</span></label>
                <input type="text" id="add-menuItemName" name="menuItemName" maxlength="155" required>
            </p>
            <p class="form-note">
                Total cost starts empty; add its ingredients on the
                <a href="/menuItemIngredients">Menu Item Ingredients</a> page,
                then use "Recalculate Total Cost" below.
            </p>
            <button type="submit">Add Menu Item</button>
        </fieldset>
    </form>
</section>

<section>
    <h2>UPDATE &mdash; Rename a Menu Item</h2>
    <form method="POST" action="/menuItems/update">
        <fieldset>
            <legend>Select a menu item and enter its new name</legend>
            <p>
                <label for="update-menuItemID">Menu Item: <span class="required-marker">*</span></label>
                <select id="update-menuItemID" name="menuItemID" required>
                    <option value="">-- select a menu item --</option>
                    {{#each menuItems}}
                    <option value="{{this.menuItemID}}">{{this.menuItemName}}</option>
                    {{/each}}
                </select>
            </p>
            <p>
                <label for="update-menuItemName">New Menu Item Name: <span class="required-marker">*</span></label>
                <input type="text" id="update-menuItemName" name="menuItemName" maxlength="155" required>
            </p>
            <button type="submit">Update Menu Item Name</button>
        </fieldset>
    </form>
</section>

<section>
    <h2>UPDATE &mdash; Recalculate a Menu Item's Total Cost</h2>
    <form method="POST" action="/menuItems/calculateTotalCost">
        <fieldset>
            <legend>Recompute total cost from ingredient amounts and preferred-vendor prices</legend>
            <p>
                <label for="calc-menuItemID">Menu Item: <span class="required-marker">*</span></label>
                <select id="calc-menuItemID" name="menuItemID" required>
                    <option value="">-- select a menu item --</option>
                    {{#each menuItems}}
                    <option value="{{this.menuItemID}}">{{this.menuItemName}}</option>
                    {{/each}}
                </select>
            </p>
            <button type="submit">Recalculate Total Cost</button>
        </fieldset>
    </form>
</section>
